Options -Indexes

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Force HTTPS + non-www
  RewriteCond %{HTTPS} off [OR]
  RewriteCond %{HTTP_HOST} ^www\.amaths\.fr$ [NC]
  RewriteRule ^ https://amaths.fr%{REQUEST_URI} [R=301,L]

  # /foo/index.html → /foo/
  RewriteCond %{THE_REQUEST} \s/+(.*/)?index\.html[\s?] [NC]
  RewriteRule ^(.*/)?index\.html$ /$1 [R=301,L]

  # Existing behavior: directories without index.html → /
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteCond %{REQUEST_FILENAME}/index.html !-f
  RewriteRule ^.*$ / [R=302,L]
</IfModule>