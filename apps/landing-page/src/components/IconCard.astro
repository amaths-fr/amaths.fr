---
import { Icon } from "astro-icon/components";

interface Props {
  icon: string;
  title: string;
  description: string;
  variant?: "default" | "contrasted";
  step?: number;
}

const { icon, title, description, variant = "default", step } = Astro.props;
---

<div class:list={["container", variant]}>
  {step && <div class="step">{step}</div>}
  <div class:list={["icon", variant]}>
    <Icon name={icon} width="1.5rem" height="1.5rem" />
  </div>
  <div class="text">
    <h4>{title}</h4>
    <p>{description}</p>
  </div>
</div>

<style>
  .container {
    position: relative;
    border: 1px solid var(--elevation-2);
    background-color: var(--elevation-1);
    padding: var(--s32);
    border-radius: var(--r16);
    display: flex;
    flex-direction: column;
    gap: var(--s24);
  }

  .step {
    position: absolute;
    top: calc(-1 * var(--s16));
    left: calc(-1 * var(--s16));
    width: var(--s32);
    height: var(--s32);
    border-radius: var(--rmax);
    background-color: var(--primary-color);
    color: var(--absolute-white);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 0.875rem;
    font-weight: var(--weight-semi-bold);
  }

  .container.contrasted {
    background: var(--section-gradient-3);
  }

  .icon {
    padding: var(--s12);
    background-color: var(--elevation-3);
    width: fit-content;
    border-radius: var(--r8);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .icon.contrasted {
    background-color: #ebbe3633;
  }

  .text {
    display: flex;
    flex-direction: column;
    gap: var(--s12);
  }

  p {
    color: var(--primary-color-tern);
  }
</style>
