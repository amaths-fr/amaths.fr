---
import Container from "../Container.astro";
import Button from "../Button.astro";
import Callout from "../Callout.astro";
import Stat from "../Stat.astro";
---

<section id="hero">
  <Container>
    <div class="callout">
      <Callout variant="primary-translucid">
        Cours de maths · Excellence académique depuis 2020
      </Callout>
    </div>
    <div class="hero-content">
      <div class="text-cta">
        <h2>
          Ma-thématique de soutien à <span class="accent">13€</span> de l'heure
        </h2>
        <p>
          2h de cours de maths · 36h de stage · suivi personnalisé — une seule
          formule.
        </p>
        <div class="levels">
          <Callout variant="primary-translucid">Seconde</Callout>
          <Callout variant="primary-translucid">Première</Callout>
          <Callout variant="primary-translucid">Terminale</Callout>
          <Callout variant="primary-translucid">Classes préparatoires</Callout>
        </div>
        <div class="cta">
          <a href="/try">
            <Button size="m" variant="accent" icon="arrow-right">
              Je veux essayer
            </Button>
          </a>
          <a href="#plans">
            <Button size="m" variant="secondary">
              Voir les formules
            </Button>
          </a>
        </div>
      </div>
      <div class="image">
        <img src="assets/hero.jpeg" alt="Hero image" />
      </div>
    </div>
    <div class="stats">
      <Stat size="l" value="+4.6" label="points en maths" />
      <Stat size="l" value="4 élèves" label="par groupe de maths" />
      <Stat size="l" value="13€" label="de l'heure de maths" />
    </div>
  </Container>
</section>

<style>
  section {
    background: var(--section-gradient-1);
    position: relative;
    padding-bottom: var(--s96);
    padding-top: calc(var(--header-height) + var(--s48));
  }

  h2 {
    font-size: 3rem;
  }

  h2 .accent {
    color: var(--accent-color);
  }

  p {
    font-size: 1.1rem;
    opacity: 0.8;
  }

  .levels {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s8);
  }

  .hero-content {
    display: flex;
    align-items: stretch;
    justify-content: stretch;
    gap: var(--s64);
  }

  .text-cta {
    max-width: 700px;
    height: 100%;
    display: flex;
    flex-direction: column;
    justify-content: center;
    flex: 1 1 auto;
    gap: var(--s32);
  }

  .image {
    flex: 0 0 600px;
    overflow: hidden;
    position: relative;
    border-radius: var(--s24);
  }

  img {
    position: absolute;
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .cta {
    display: flex;
    gap: var(--s16);
  }

  .hint {
    font-size: 0.875rem;
    opacity: 0.6;
  }

  .stats {
    margin-top: var(--s64);
    gap: var(--s128);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .callout {
    margin-bottom: var(--s32);
  }

  @media (max-width: 1150px) {
    .hero-content {
      flex-direction: column;
      gap: var(--s48);
    }

    .text-cta {
      max-width: none;
    }

    .image {
      width: 100%;
    }
  }

  @media (max-width: 815px) {
    .stats {
      flex-direction: column;
      gap: var(--s64);
    }
  }

  @media (max-width: 560px) {
    .cta {
      flex-direction: column;
    }

    .hero-content {
      gap: var(--s32);
    }
  }
</style>
