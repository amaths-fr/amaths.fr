---
import Container from "../Container.astro";
import SectionHead from "../SectionHead.astro";
import IconCard from "../IconCard.astro";
---

<section id="method">
  <Container>
    <SectionHead>
      <h3>Notre méthode pour progresser en maths :</h3>
      <p class="quote">
        « Pour nous, la progression en maths passe par de la régularité et de la
        rigueur dans le travail. »
      </p>
    </SectionHead>
    <div class="cards">
      <IconCard
        variant="contrasted"
        icon="book"
        title="Séances de maths structurées de 2h"
        description="Chaque cours de maths suit une progression claire : rappel, exercices types, approfondissement. Comme en prépa, mais adapté au niveau lycée."
      />
      <IconCard
        variant="contrasted"
        icon="user-group"
        title="Petits groupes de maths (4 élèves max)"
        description="Un équilibre parfait entre dynamique de groupe et attention personnalisée. Chaque élève progresse en mathématiques à son rythme."
      />
      <IconCard
        variant="contrasted"
        icon="calendar"
        title="Stages intensifs de mathématiques"
        description="Pendant chaque période de vacances scolaires, un stage de maths en groupe d'une trentaine d'heures pour consolider ou se préparer aux examens."
      />
      <IconCard
        variant="contrasted"
        icon="text-bubble"
        title="Suivi en temps réel"
        description="Moyenne en maths, progression, replays de cours : tout est centralisé dans un espace personnel, consultable à tout moment par l'élève et ses parents."
      />
    </div>
  </Container>
</section>

<style>
  section {
    background: var(--section-gradient-2);
  }

  .cards {
    padding-top: var(--s64);
    display: grid;
    grid-template-columns: var(--grid-opti-4);
    grid-gap: var(--s32);
  }

  p {
    font-size: 1.2rem;
  }

  .quote {
    font-style: italic;
  }
</style>
