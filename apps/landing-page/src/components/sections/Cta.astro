---
import Container from "../Container.astro";
import Button from "../Button.astro";
import { Icon } from "astro-icon/components";
import { AIRTABLE_FORM_BASE_URL } from "../../const.ts";
---

<section id="try">
  <div class="blob position-left"></div>
  <div class="blob position-right"></div>
  <Container>
    <div class="text">
      <h2>Prêt à progresser en maths ?</h2>
      <p>Rejoignez les centaines d'élèves qui nous font confiance.<br />Cours d'essai sans engagement.</p>
    </div>
    <div class="cta">
      <a href={AIRTABLE_FORM_BASE_URL} target="_blank">
        <Button size="l" variant="accent" icon="arrow-right">Réserver mon cours d'essai</Button>
      </a>
      <a href={AIRTABLE_FORM_BASE_URL} target="_blank">
        <Button size="l" variant="glassy">Nous contacter</Button>
      </a>
    </div>
    <div class="center">
      <div class="promises">
        <div class="promise">
          <Icon name="circle-check" />
          <div class="promise-text">Premier cours gratuit</div>
        </div>
        <div class="promise">
          <Icon name="circle-check" />
          <div class="promise-text">Sans engagement</div>
        </div>
        <div class="promise">
          <Icon name="circle-check" />
          <div class="promise-text">Résultats garantis</div>
        </div>
      </div>
    </div>
  </Container>
</section>

<style>
  section {
    padding-bottom: var(--s96);
    padding-top: var(--s96);
    background: linear-gradient(180deg, #5466b7, #14205c 50% 100%);
    position: relative;
  }

  .text {
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  h2 {
    color: var(--absolute-white);
    font-size: 3.75rem;
    text-align: center;
  }

  p {
    color: var(--absolute-white);
    font-size: 1.3rem;
    opacity: 0.8;
    max-width: 700px;
    text-align: center;
    padding-top: var(--s24);
  }

  .cta {
    display: flex;
    gap: var(--s24);
    padding-top: var(--s48);
    justify-content: center;
  }

  .center {
    display: flex;
    justify-content: center;
    padding-top: var(--s48);
  }

  .promises {
    width: 100%;
    max-width: 800px;
    border-top: 1px solid rgba(255, 255, 255, 0.2);
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    grid-row-gap: var(--s32);
    padding-top: var(--s32);
  }

  .promise {
    color: var(--accent-color);
    display: flex;
    align-items: center;
    gap: var(--s8);
    padding: 0 var(--s32);
    font-size: 1.5rem;
  }

  .promise-text {
    font-size: 1rem;
    color: var(--absolute-white);
  }

  .blob {
    position: absolute;
    width: 200px;
    height: 200px;
    border-radius: 50%;
    background: var(--absolute-white);
    filter: blur(128px);
    opacity: 0.5;
    pointer-events: none;
  }

  .position-left {
    left: 0;
    top: 20%;
  }

  .position-right {
    right: 0;
    top: 20%;
  }

  @media (max-width: 820px) {
    .promises {
      grid-template-columns: 1fr;
    }

    .promise {
      justify-content: center;
    }
  }

  @media (max-width: 610px) {
    .cta {
      flex-direction: column;
      gap: var(--s16);
    }

    .cta button {
      width: 100%;
    }
  }
</style>
