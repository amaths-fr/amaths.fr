---
import { Icon } from "astro-icon/components";
import Button from "./Button.astro";

interface Props {
  title: string;
  subtitle: string;
  price: string;
  priceSuffix?: string;
  advantages: string[];
  ctaHref: string;
  ctaLabel?: string;
  featured?: boolean;
}

const {
  title,
  subtitle,
  price,
  priceSuffix = "TTC/mois",
  advantages,
  ctaHref,
  ctaLabel = "Réserver",
  featured = false,
} = Astro.props;
---

<div class:list={["container", { featured }]}>
  {featured && (
    <div class="badge">
      <Icon name="stars" /> Le plus choisi
    </div>
  )}
  <div class="header">
    <h4>{title}</h4>
    <p>{subtitle}</p>
  </div>
  <div class="price">
    {price}€<span class="ht"> {priceSuffix}</span>
  </div>
  <div class="advantages">
    {advantages.map((advantage) => (
      <div class="advantage">
        <Icon name="check" />
        <p>{advantage}</p>
      </div>
    ))}
  </div>
  <a href={ctaHref}>
    <Button size="m" variant={featured ? "accent" : "primary"}>
      {ctaLabel}
    </Button>
  </a>
</div>

<style>
  .price {
    font-weight: var(--weight-black);
    font-size: 3rem;
  }

  .container.featured {
    border-color: var(--accent-color);
    transform: scale(1.03);
  }

  .badge {
    position: absolute;
    top: calc(-1 * var(--s16));
    left: 50%;
    transform: translateX(-50%);
    background-color: var(--accent-color);
    color: var(--primary-color);
    font-size: 0.8rem;
    font-weight: var(--weight-medium);
    padding: var(--s8) var(--s16);
    border-radius: var(--r24);
    white-space: nowrap;
    display: flex;
    align-items: center;
    gap: var(--s4);
  }

  .ht {
    font-weight: 400;
    font-size: 1.2rem;
    color: var(--primary-color-tern);
  }

  .header {
    display: flex;
    flex-direction: column;
    gap: var(--s8);
  }

  .container {
    position: relative;
    padding: var(--s32);
    background: var(--absolute-white);
    border: 2px solid var(--elevation-2);
    border-radius: var(--r8);
    transition: all 0.2s ease-in-out;
    display: flex;
    flex-direction: column;
    gap: var(--s24);
    justify-content: space-between;
  }

  .container:hover:not(.featured) {
    border: 2px solid var(--primary-color);
    transform: scale(1.03);
  }

  h4 {
    font-size: 1.5rem;
  }

  .header p {
    font-size: 0.875rem;
    color: var(--primary-color-tern);
  }

  .advantages {
    display: flex;
    flex-direction: column;
    gap: var(--s12);
  }

  .advantage {
    color: var(--accent-color);
    display: flex;
    align-items: center;
    gap: var(--s8);
  }

  .advantage p {
    color: var(--primary-color-tern);
    font-size: 0.875rem;
  }
</style>
